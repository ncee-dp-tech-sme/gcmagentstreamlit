# Copy to .env and adjust. Never commit .env.
# Logging level: DEBUG | INFO | WARNING | ERROR (DEBUG also shows technical error details in the UI)
LOG_LEVEL=INFO

# Directory for the persisted (encrypted) configuration
DATA_DIR=data

# Optional Fernet key for encrypting saved secrets. If empty, a key file is generated in DATA_DIR.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GCM_APP_ENCRYPTION_KEY=

# Guardium Cryptography Manager defaults (used until settings are saved in the UI)
GCM_SERVER_URL=https://gcm.example.com
GCM_MCP_TOKEN=example-token-change-me  # HashiCorpIgnore
GCM_VERIFY_SSL=true

# AI provider defaults: 1min.ai | OpenAI | Gemini | IBM
AI_PROVIDER=1min.ai
ONEMIN_API_KEY=  # HashiCorpIgnore
OPENAI_API_KEY=  # HashiCorpIgnore
GEMINI_API_KEY=  # HashiCorpIgnore
IBM_API_KEY=  # HashiCorpIgnore
IBM_URL=https://us-south.ml.cloud.ibm.com
IBM_PROJECT_ID=
